# ==========================================
# DocuMind AI — Backend Configuration
# ==========================================

# OpenAI API Key (required for embeddings + LLM generation)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Selection
MODEL_NAME=gpt-4o-mini
# OpenAI text-embedding-3-small is the default for cloud/Vercel deployments
EMBEDDING_MODEL=openai-text-embedding-3-small

# Qdrant Cloud Vector Database (replaces ChromaDB for serverless deployments)
# Sign up free at https://cloud.qdrant.io → create a cluster → copy URL + API key
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=documind_vectors

# RAG Hyperparameters
TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=120
SIMILARITY_THRESHOLD=0.25
